# Copy to .env and fill in. Keep values unquoted (KEY=value). Never commit .env.

# Chat providers (at least one). Groq is used as the default when its key is present.
GROQ_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Tools
TAVILY_API_KEY=

# Sessions (any long random string)
SESSION_SECRET=

# Firebase web app config (Project settings -> Your apps -> Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional
# DEFAULT_MODEL=openai/gpt-oss-120b
# TITLE_MODEL=openai/gpt-oss-20b
# GENERATE_TITLES=true
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=KrixGPT
# DOMAIN=your.host.name   # only for docker-compose.prod.yml (HTTPS proxy)
